# Database Configuration (Local H2 default / AWS RDS override)
# Example AWS RDS PostgreSQL/MySQL URL: jdbc:postgresql://<rds-endpoint>:5432/nutricionaldb
DB_URL=jdbc:h2:mem:nutricionaldb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USER=sa
DB_PASSWORD=

# JPA / Hibernate Console
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=true

# AWS Cloud Configuration (EC2 / RDS / S3 Free Tier)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_ENABLED=false
AWS_S3_BUCKET=nutricional-coach-pdfs
# LocalStack emulator in Windows (leave empty in real AWS S3)
# AWS_S3_ENDPOINT=http://localhost:14566
AWS_S3_PATH_STYLE_ACCESS=false

# Optional: uncomment to preload demo seed data (DataInitializer under "local" profile)
# SPRING_PROFILES_ACTIVE=local

# Production profile ("prod") overrides for AWS RDS PostgreSQL
# PROD_JPA_DDL_AUTO=validate
